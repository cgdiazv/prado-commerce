datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model MerchantUser {
  id                       String   @id @default(cuid())
  email                    String   @unique
  name                     String?
  company                  String?
  plan                     SubscriptionPlan @default(STARTER)
  stripeCustomerId         String?  @unique
  stripeSubId              String?  @unique
  passwordHash             String?
  passwordSetAt            DateTime?
  sessionVersion           Int      @default(0)
  onboardingTokenId        String?  @unique
  onboardingTokenHash      String?
  onboardingTokenExpiresAt DateTime?
  passwordResetTokenId     String?  @unique
  passwordResetTokenHash   String?
  passwordResetTokenExpiresAt DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  stores    Store[]

  @@index([createdAt])
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

// ==========================================
// STORE / TENANT MANAGEMENT & API KEYS
// ==========================================

model Store {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  customDomain   String?    @unique
  mainColor      String     @default("#0f172a")
  ownerId        String
  ownerUserId    String?
  ownerUser      MerchantUser? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  currency       String     @default("USD")
  timezone       String     @default("America/New_York")
  allowedDomains String[]
  offlinePaymentsEnabled Boolean @default(false)

  apiKeys        ApiKey[]
  products       Product[]
  categories     Category[]
  carts          Cart[]
  orders         Order[]
  customers      Customer[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([ownerId])
  @@index([ownerUserId])
}

model ApiKey {
  id         String     @id @default(cuid())
  storeId    String
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name       String
  type       ApiKeyType @default(PUBLISHABLE)
  key        String     @unique

  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([storeId])
  @@index([key])
}

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

// ==========================================
// PRODUCTS, VARIANTS & INVENTORY
// ==========================================

model Category {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  parentCategoryId String?
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories  Category[] @relation("CategoryHierarchy")
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentCategoryId])
}

model Product {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String?        @db.Text
  images      String[]
  featured    Boolean        @default(false)
  status      ProductStatus  @default(DRAFT)
  productType ProductType    @default(PHYSICAL)

  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants    ProductVariant[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([status])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String?
  title          String
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)

  inventory      Int         @default(0)
  trackInventory Boolean     @default(true)

  options        Json?

  cartItems      CartItem[]
  orderItems     OrderItem[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([productId])
  @@index([sku])
}

// ==========================================
// SHOPPING CART ENGINE
// ==========================================

model Cart {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  token       String     @unique @default(cuid())

  currency    String     @default("USD")
  items       CartItem[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([storeId])
  @@index([token])
  @@index([customerId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity  Int            @default(1)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ==========================================
// CUSTOMERS & ORDERS
// ==========================================

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  email     String
  firstName String?
  lastName  String?
  phone     String?
  passwordHash    String?
  shippingAddress Json?
  billingAddress  Json?
  savedAddresses  Json?

  orders    Order[]
  carts     Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId])
}

model Order {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orderNumber     Int           @unique @default(autoincrement())

  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail   String

  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)

  total           Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @default(0.00) @db.Decimal(10, 2)
  shipping        Decimal       @default(0.00) @db.Decimal(10, 2)
  currency        String        @default("USD")

  stripeSessionId String?       @unique
  stripePaymentId String?       @unique

  shippingAddress Json?
  billingAddress  Json?
  paymentMethod   String?       @default("card")

  items           OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([storeId])
  @@index([customerId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  title     String
  price     Decimal         @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
}

model AccountRequest {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   String?
  approvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
