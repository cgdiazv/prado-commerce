datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model MerchantUser {
  id                       String   @id @default(cuid())
  email                    String   @unique
  name                     String?
  company                  String?
  phone                    String?
  address                  String?
  addressType              String?
  plan                     SubscriptionPlan @default(STARTER)
  businessCategory         String?
  catalogSize              String?
  salesChannels            String[] @default([])
  preferredTheme           StorefrontTheme?
  questionnaireAnswers     Json?
  stripeCustomerId         String?  @unique
  stripeSubId              String?  @unique
  passwordHash             String?
  passwordSetAt            DateTime?
  sessionVersion           Int      @default(0)
  onboardingTokenId        String?  @unique
  onboardingTokenHash      String?
  onboardingTokenExpiresAt DateTime?
  passwordResetTokenId     String?  @unique
  passwordResetTokenHash   String?
  passwordResetTokenExpiresAt DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  stores    Store[]

  @@index([createdAt])
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

// ==========================================
// STORE / TENANT MANAGEMENT & API KEYS
// ==========================================

model Store {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  logoUrl        String?
  heroImageUrl   String?
  heroEyebrow    String?
  heroTitle      String?
  heroSubtitle   String?
  heroButtonText String?
  activeTheme    StorefrontTheme @default(MINIMAL)
  customDomain   String?    @unique
  stripeConnectAccountId String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)
  authNetLoginId String?
  authNetClientKey String?
  authNetTransKeyEncrypted String?
  authNetEnv     String     @default("sandbox")
  shipStationApiKeyEncrypted String?
  shipStationApiSecretEncrypted String?
  shipStationWebhookId String?
  shipStationWebhookSecretHash String?
  mainColor      String     @default("#0f172a")
  ownerId        String
  ownerUserId    String?
  ownerUser      MerchantUser? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  currency       String     @default("USD")
  timezone       String     @default("America/New_York")
  allowedDomains String[]
  offlinePaymentsEnabled Boolean @default(false)
  welcomeEmailEnabled Boolean @default(false)
  orderConfirmationEmailEnabled Boolean @default(false)
  invoiceEmailEnabled Boolean @default(false)
  senderName     String?
  senderEmail    String?
  replyToEmail   String?
  shippingZones  Json?
  shippingOrigin Json?
  invoiceFooterText String?
  invoicePrefix  String?    @default("INV-")
  nextInvoiceNumber Int     @default(1001)

  apiKeys        ApiKey[]
  products       Product[]
  categories     Category[]
  carts          Cart[]
  orders         Order[]
  customers      Customer[]
  vendors        Vendor[]
  purchaseOrders PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([ownerId])
  @@index([ownerUserId])
}

enum StorefrontTheme {
  MINIMAL
  BOLD
  CLASSIC
}

model ApiKey {
  id         String     @id @default(cuid())
  storeId    String
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name       String
  type       ApiKeyType @default(PUBLISHABLE)
  key        String     @unique

  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([storeId])
  @@index([key])
}

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

// ==========================================
// PRODUCTS, VARIANTS & INVENTORY
// ==========================================

model Category {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  parentCategoryId String?
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories  Category[] @relation("CategoryHierarchy")
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentCategoryId])
}

model Product {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title       String
  slug        String
  description String?        @db.Text
  images      String[]
  featured    Boolean        @default(false)
  status      ProductStatus  @default(DRAFT)
  productType ProductType    @default(PHYSICAL)

  dimension    String?
  weight       String?
  manufacturer String?
  condition    String?
  conditionNotes String?      @db.Text

  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants    ProductVariant[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([status])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String?
  title          String
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)

  inventory      Int         @default(0)
  trackInventory Boolean     @default(true)

  options        Json?

  cartItems      CartItem[]
  orderItems     OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([productId])
  @@index([sku])
}

// ==========================================
// SHOPPING CART ENGINE
// ==========================================

model Cart {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  token       String     @unique @default(cuid())

  currency    String     @default("USD")
  items       CartItem[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([storeId])
  @@index([token])
  @@index([customerId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity  Int            @default(1)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ==========================================
// CUSTOMERS & ORDERS
// ==========================================

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  email     String
  firstName String?
  lastName  String?
  phone     String?
  passwordHash    String?
  passwordResetTokenId     String? @unique
  passwordResetTokenHash    String?
  passwordResetTokenExpiresAt DateTime?
  shippingAddress Json?
  billingAddress  Json?
  savedAddresses  Json?

  orders    Order[]
  carts     Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@index([storeId])
}

model Order {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  orderNumber     Int           @unique @default(autoincrement())

  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail   String

  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)

  total           Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @default(0.00) @db.Decimal(10, 2)
  shipping        Decimal       @default(0.00) @db.Decimal(10, 2)
  currency        String        @default("USD")
  paymentProvider String?       @default("manual")
  gatewayTransactionId String?

  stripeSessionId String?       @unique
  stripePaymentId String?       @unique

  shippingAddress Json?
  billingAddress  Json?
  paymentMethod   String?       @default("card")
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  trackingNumber String?
  trackingCarrier String?
  trackingUrl String?
  shippedAt DateTime?
  shipStationOrderId String? @unique
  shipStationSyncedAt DateTime?
  shipStationSyncError String?

  items           OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([storeId])
  @@index([customerId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum FulfillmentStatus {
  UNFULFILLED
  SHIPPED
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  title     String
  price     Decimal         @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
}

model AccountRequest {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   String?
  approvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ==========================================
// PROCUREMENT & RECEIVING MODULES
// ==========================================

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model Vendor {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  notes        String?  @db.Text

  purchaseOrders PurchaseOrder[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
  @@index([name])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  storeId      String
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  vendorId     String
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  poNumber     String
  status       PurchaseOrderStatus @default(DRAFT)

  issueDate    DateTime            @default(now())
  expectedDate DateTime?

  notes        String?             @db.Text
  subtotal     Decimal             @default(0.00) @db.Decimal(10, 2)
  tax          Decimal             @default(0.00) @db.Decimal(10, 2)
  shipping     Decimal             @default(0.00) @db.Decimal(10, 2)
  total        Decimal             @default(0.00) @db.Decimal(10, 2)

  items        PurchaseOrderItem[]
  receipts     PurchaseReceipt[]

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([storeId, poNumber])
  @@index([storeId])
  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  poId            String
  purchaseOrder   PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)

  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  title           String
  sku             String?
  qtyOrdered      Int
  qtyReceived     Int            @default(0)
  unitCost        Decimal        @db.Decimal(10, 2)
  totalCost       Decimal        @db.Decimal(10, 2)

  receiptItems    PurchaseReceiptItem[]

  @@index([poId])
  @@index([variantId])
}

model PurchaseReceipt {
  id            String                @id @default(cuid())
  poId          String
  purchaseOrder PurchaseOrder         @relation(fields: [poId], references: [id], onDelete: Cascade)

  storeId       String
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  receivedAt    DateTime              @default(now())
  receivedBy    String?
  notes         String?               @db.Text

  items         PurchaseReceiptItem[]

  @@index([poId])
  @@index([storeId])
}

model PurchaseReceiptItem {
  id          String            @id @default(cuid())
  receiptId   String
  receipt     PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  poItemId    String
  poItem      PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Cascade)

  qtyReceived Int

  @@index([receiptId])
  @@index([poItemId])
}
